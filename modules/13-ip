#!/usr/bin/env bash
set -euo pipefail
source "${BASE_DIR}/framework.sh"

ips_v4=$(ip -o addr show scope global 2>/dev/null \
    | awk '$2 !~ /^(docker|br-|veth|virbr|tun|tap)/ { split($4, arr, "/"); print arr[1] }')

ips=()
while IFS= read -r line; do
    [[ -n "$line" ]] && ips+=("$line")
done <<< "$ips_v4"

text=$(print_wrap "${WIDTH}" "${ips[@]}")
print_columns "Internal IP(s)" "${text}"
